# Copy to .env.local and fill in. Everything here is optional.

# Canonical URL used for SEO (sitemap, Open Graph, JSON-LD). Set to your Vercel/custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social links. A button is only shown when its URL is set, so nothing ever points nowhere.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# Optional profile photo (path under /public, e.g. /profile.jpg). Falls back to an animated "DP" avatar.
NEXT_PUBLIC_PROFILE_IMAGE=

# Contact form delivery via Resend (https://resend.com). If RESEND_API_KEY is not set,
# the form falls back to opening the visitor's email app with the message pre-filled.
RESEND_API_KEY=
CONTACT_TO_EMAIL=deepakkumarpradhan441@gmail.com
# Must be a sender verified in Resend, e.g. "Portfolio <contact@yourdomain.com>"
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
